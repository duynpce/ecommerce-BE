<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_19fjjgi" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="returning-items-procedure" name="returning items procedure" isExecutable="true">
    <bpmn:documentation>Coordinates pickup and delivery of a customer return back to its contributor by reusing the shared delivery process.</bpmn:documentation>
    <bpmn:startEvent id="ReturnStart" name="return initiated">
      <bpmn:outgoing>Flow_1py9zay</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ReturnConfirm" name="Confirm Returned Product Received" camunda:assignee="${contributorId}">
      <bpmn:documentation>Contributor confirms that the returned product has physically arrived. No return choice available at this step.</bpmn:documentation>
      <bpmn:incoming>Flow_ReturnDeliveryReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_1rsxwv4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1ujpt6r" name="Evaluate Contributor Confirmation">
      <bpmn:documentation>Routes a confirmed receipt to completion or a missing return to retry accounting.</bpmn:documentation>
      <bpmn:incoming>Flow_1rsxwv4</bpmn:incoming>
      <bpmn:outgoing>Flow_1nre2tr</bpmn:outgoing>
      <bpmn:outgoing>Flow_06ww3ap</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="returned-product-recieved" name="Complete Product Return" camunda:delegateExpression="${returnProductReceivedDelegate}">
      <bpmn:documentation>Marks the physical return as complete and restores stock idempotently.</bpmn:documentation>
      <bpmn:incoming>Flow_1nre2tr</bpmn:incoming>
      <bpmn:outgoing>Flow_13jcj61</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="returned-product-not-recieved" name="Record Return Not Received" camunda:delegateExpression="${returnProductNotReceivedDelegate}">
      <bpmn:documentation>Increments the shared delivery retry counter after the contributor reports that the return did not arrive.</bpmn:documentation>
      <bpmn:incoming>Flow_06ww3ap</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnConfirmationRecorded</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ReturnEnd" name="return completed">
      <bpmn:incoming>Flow_13jcj61</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1rsxwv4" sourceRef="ReturnConfirm" targetRef="Gateway_1ujpt6r" />
    <bpmn:endEvent id="Event_0y0pq24" name="return failed">
      <bpmn:incoming>Flow_0p5wjr8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1nre2tr" sourceRef="Gateway_1ujpt6r" targetRef="returned-product-recieved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "RECEIVED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06ww3ap" sourceRef="Gateway_1ujpt6r" targetRef="returned-product-not-recieved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "NOT_RECEIVED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13jcj61" sourceRef="returned-product-recieved" targetRef="ReturnEnd" />
    <bpmn:serviceTask id="product-return-failed" name="Mark Product Return Failed" camunda:delegateExpression="${returnProductFailedDelegate}">
      <bpmn:documentation>Records that the return could not be delivered after the maximum number of attempts.</bpmn:documentation>
      <bpmn:incoming>Flow_1m0dg0q</bpmn:incoming>
      <bpmn:incoming>Flow_ReturnDeliveryFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_0p5wjr8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1m0dg0q" sourceRef="Gateway_ReturnRetryLimit" targetRef="product-return-failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${retry &gt;= 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0p5wjr8" sourceRef="product-return-failed" targetRef="Event_0y0pq24" />
    <bpmn:userTask id="Activity_0svpfqw" name="Accept Return for Pickup" camunda:candidateGroups="SHIPPER">
      <bpmn:documentation>A shipper accepts responsibility for collecting the returned product and taking it back to the contributor.</bpmn:documentation>
      <bpmn:incoming>Flow_1py9zay</bpmn:incoming>
      <bpmn:incoming>Flow_ReturnDeliveryRetry</bpmn:incoming>
      <bpmn:incoming>Flow_ReturnContributorRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_0bnm4ik</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1py9zay" sourceRef="ReturnStart" targetRef="Activity_0svpfqw" />
    <bpmn:callActivity id="Activity_14lu3eu" name="Run Return Delivery" calledElement="delivery-process">
      <bpmn:documentation>Calls the shared delivery process in return mode using the shipper who accepted this pickup.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:in sourceExpression="${true}" target="returnProcess" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0bnm4ik</bpmn:incoming>
      <bpmn:outgoing>Flow_0ivf9se</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_0bnm4ik" sourceRef="Activity_0svpfqw" targetRef="Activity_14lu3eu" />
    <bpmn:sequenceFlow id="Flow_0ivf9se" sourceRef="Activity_14lu3eu" targetRef="Gateway_ReturnDeliveryOutcome" />
    <bpmn:exclusiveGateway id="Gateway_ReturnDeliveryOutcome" name="Evaluate Return Delivery">
      <bpmn:documentation>Routes a delivered return to contributor confirmation, retries a failed attempt, or ends an exhausted return.</bpmn:documentation>
      <bpmn:incoming>Flow_0ivf9se</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnDeliveryReceived</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReturnDeliveryRetry</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReturnDeliveryFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ReturnDeliveryReceived" sourceRef="Gateway_ReturnDeliveryOutcome" targetRef="ReturnConfirm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliveryOutcome == "DELIVERED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReturnDeliveryRetry" sourceRef="Gateway_ReturnDeliveryOutcome" targetRef="Activity_0svpfqw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliveryOutcome == "RETRY" &amp;&amp; retry &lt; 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReturnDeliveryFailed" sourceRef="Gateway_ReturnDeliveryOutcome" targetRef="product-return-failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliveryOutcome == "DELIVERY_FAILED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_ReturnRetryLimit" name="Return Retry Available?">
      <bpmn:documentation>Checks the shared retry counter after a contributor reports that the returned product was not received.</bpmn:documentation>
      <bpmn:incoming>Flow_ReturnConfirmationRecorded</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnContributorRetry</bpmn:outgoing>
      <bpmn:outgoing>Flow_1m0dg0q</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ReturnConfirmationRecorded" sourceRef="returned-product-not-recieved" targetRef="Gateway_ReturnRetryLimit" />
    <bpmn:sequenceFlow id="Flow_ReturnContributorRetry" sourceRef="Gateway_ReturnRetryLimit" targetRef="Activity_0svpfqw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${retry &lt; 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="returning-items-procedure">
      <bpmndi:BPMNShape id="ReturnStart_di" bpmnElement="ReturnStart">
        <dc:Bounds x="172" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="155" y="265" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0svpfqw_di" bpmnElement="Activity_0svpfqw">
        <dc:Bounds x="270" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_14lu3eu_di" bpmnElement="Activity_14lu3eu">
        <dc:Bounds x="440" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ReturnDeliveryOutcome_di" bpmnElement="Gateway_ReturnDeliveryOutcome" isMarkerVisible="true">
        <dc:Bounds x="566" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReturnConfirm_di" bpmnElement="ReturnConfirm">
        <dc:Bounds x="616" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1ujpt6r_di" bpmnElement="Gateway_1ujpt6r" isMarkerVisible="true">
        <dc:Bounds x="781" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReturnSetStatus_di" bpmnElement="returned-product-recieved">
        <dc:Bounds x="936" y="200" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_180sl6b_di" bpmnElement="returned-product-not-recieved">
        <dc:Bounds x="936" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ReturnRetryLimit_di" bpmnElement="Gateway_ReturnRetryLimit" isMarkerVisible="true">
        <dc:Bounds x="1080" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReturnEnd_di" bpmnElement="ReturnEnd">
        <dc:Bounds x="1118" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1095" y="265" width="83" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0y0pq24_di" bpmnElement="Event_0y0pq24">
        <dc:Bounds x="1118" y="332" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1107" y="375" width="59" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1taq6v8_di" bpmnElement="product-return-failed">
        <dc:Bounds x="936" y="310" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1py9zay_di" bpmnElement="Flow_1py9zay">
        <di:waypoint x="208" y="240" />
        <di:waypoint x="270" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0bnm4ik_di" bpmnElement="Flow_0bnm4ik">
        <di:waypoint x="370" y="240" />
        <di:waypoint x="440" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1rsxwv4_di" bpmnElement="Flow_1rsxwv4">
        <di:waypoint x="716" y="240" />
        <di:waypoint x="781" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1nre2tr_di" bpmnElement="Flow_1nre2tr">
        <di:waypoint x="831" y="240" />
        <di:waypoint x="936" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06ww3ap_di" bpmnElement="Flow_06ww3ap">
        <di:waypoint x="806" y="215" />
