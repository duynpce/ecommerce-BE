        <di:waypoint x="936" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReturnConfirmationRecorded_di" bpmnElement="Flow_ReturnConfirmationRecorded">
        <di:waypoint x="1036" y="120" />
        <di:waypoint x="1080" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReturnContributorRetry_di" bpmnElement="Flow_ReturnContributorRetry">
        <di:waypoint x="1105" y="95" />
        <di:waypoint x="1105" y="20" />
        <di:waypoint x="300" y="20" />
        <di:waypoint x="300" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
