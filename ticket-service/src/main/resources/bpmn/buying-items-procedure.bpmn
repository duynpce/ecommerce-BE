<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_11zc6qf" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="buying-items-procedure" name="buying items procedure" isExecutable="true">
    <bpmn:documentation>Coordinates a purchase transaction across its shop-level sub-orders and product snapshots, from contributor confirmation through delivery, review, return, cancellation, rejection, and final transaction completion.</bpmn:documentation>
    <bpmn:extensionElements>
      <camunda:executionListener delegateExpression="${syncDbStatusDelegate}" event="start" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="start-buy-products" name="buy products">
      <bpmn:documentation>can buy one or multiple products ,transaction status is pending</bpmn:documentation>
      <bpmn:outgoing>Flow_1r5wkgl</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="create-transaction-and-sub-order" name="create transaction and sub-order" camunda:delegateExpression="${createTransactionAndSubOrderDelegate}">
      <bpmn:documentation>transaction contain sub-orders (each sub-order is for a different shop) , a sub-order contain product snapshots which represent the delivery status of a product</bpmn:documentation>
      <bpmn:incoming>Flow_1r5wkgl</bpmn:incoming>
      <bpmn:outgoing>Flow_1s47z05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1r5wkgl" sourceRef="start-buy-products" targetRef="create-transaction-and-sub-order" />
    <bpmn:sequenceFlow id="Flow_1s47z05" sourceRef="create-transaction-and-sub-order" targetRef="multi-instance-sub-process" />
    <bpmn:endEvent id="Event_0psd029" name="transaction complete">
      <bpmn:documentation>Calculates and persists the final parent transaction status after every sub-order instance has ended.</bpmn:documentation>
      <bpmn:incoming>Flow_0f375rx</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_01sfitk" camunda:delegateExpression="${completeTransactionDelegate}" />
    </bpmn:endEvent>
    <bpmn:subProcess id="multi-instance-sub-process" name="multi-instance sub-process for sub-orders">
      <bpmn:documentation>Runs one parallel workflow instance for every sub-order in the transaction.</bpmn:documentation>
      <bpmn:incoming>Flow_1s47z05</bpmn:incoming>
      <bpmn:outgoing>Flow_0f375rx</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics camunda:collection="subOrderIds" camunda:elementVariable="subOrderId" />
      <bpmn:subProcess id="Activity_1oo2pcq" name="Product Snapshot Fulfilment">
        <bpmn:documentation>Runs delivery confirmation, review, completion, and return handling once for every product snapshot in the current sub-order.</bpmn:documentation>
        <bpmn:incoming>Flow_1dx9lqy</bpmn:incoming>
        <bpmn:multiInstanceLoopCharacteristics camunda:collection="${execution.getVariable(&#39;snapshotIds_&#39;.concat(subOrderId))}" camunda:elementVariable="snapshotId" />
        <bpmn:serviceTask id="mark-snapshot-returned-check-completiona" name="Mark Snapshot returned &#38; Check Completion" camunda:delegateExpression="${markSnapshotReturnAndCheckCompletionDelegate}">
          <bpmn:documentation>Persists the current snapshot as RETURNED and checks whether all snapshots in the sub-order have reached a terminal status.</bpmn:documentation>
          <bpmn:incoming>Flow_0qynngk</bpmn:incoming>
          <bpmn:outgoing>Flow_1le0n4j</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="Event_1hd9vqw" name="sub-order completed">
          <bpmn:documentation>Ends the snapshot workflow after all returned snapshots are finalized and starts the required return process.</bpmn:documentation>
          <bpmn:incoming>Flow_003bx1n</bpmn:incoming>
          <bpmn:messageEventDefinition id="MessageEventDefinition_0lnq0c2" camunda:delegateExpression="${startReturnProcessDelegate}" />
        </bpmn:endEvent>
        <bpmn:serviceTask id="mark-snapshot-reviewed-check-completiona" name="Mark Snapshot Reviewed &#38; Check Completion" camunda:delegateExpression="${markSnapshotReviewAndCheckCompletionDelegate}">
          <bpmn:documentation>set is review to true and complete sub-order if all of snapshot is review is true</bpmn:documentation>
          <bpmn:incoming>Flow_0aakhix</bpmn:incoming>
          <bpmn:incoming>Flow_1kgg2b3</bpmn:incoming>
          <bpmn:outgoing>Flow_0x7oukv</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="Gateway_1y0n83r" name="All Snapshots Completed?" camunda:asyncBefore="true">
          <bpmn:documentation>Checks whether every snapshot in the current sub-order has reached a terminal completion state.</bpmn:documentation>
          <bpmn:incoming>Flow_0x7oukv</bpmn:incoming>
          <bpmn:outgoing>Flow_1sbtnyr</bpmn:outgoing>
          <bpmn:outgoing>Flow_0gqon7d</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Flow_0x7oukv" sourceRef="mark-snapshot-reviewed-check-completiona" targetRef="Gateway_1y0n83r" />
        <bpmn:endEvent id="sub-order-completed" name="sub-order completed">
          <bpmn:documentation>Persists the current sub-order as COMPLETED when all of its snapshots are complete.</bpmn:documentation>
          <bpmn:incoming>Flow_1sbtnyr</bpmn:incoming>
          <bpmn:messageEventDefinition id="MessageEventDefinition_1lth0uo" camunda:delegateExpression="${completeSubOrderDelegate}" />
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_1sbtnyr" sourceRef="Gateway_1y0n83r" targetRef="sub-order-completed">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allSnapshotCompleted == true}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:userTask id="confirm-delivery-status" name="Confirm Delivery Status" camunda:assignee="the buyer of the product">
          <bpmn:documentation>customer confirm if the had received the product or not,
if they are not sastified with the product they can return it at this step</bpmn:documentation>
          <bpmn:incoming>Flow_161aw17</bpmn:incoming>
          <bpmn:outgoing>Flow_1l0tmco</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="Flow_1l0tmco" sourceRef="confirm-delivery-status" targetRef="Gateway_17zsqkh" />
        <bpmn:exclusiveGateway id="Gateway_17zsqkh" name="Evaluate Buyer Confirmation">
          <bpmn:documentation>Routes the buyer's confirmation to received-item review or returned-item handling.</bpmn:documentation>
          <bpmn:incoming>Flow_1l0tmco</bpmn:incoming>
          <bpmn:outgoing>Flow_0qynngk</bpmn:outgoing>
          <bpmn:outgoing>Flow_11399hj</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Flow_0qynngk" name="status is returned" sourceRef="Gateway_17zsqkh" targetRef="mark-snapshot-returned-check-completiona">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "RETURNED" || retry &gt;= 3}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:serviceTask id="product-received" name="product received" camunda:delegateExpression="${productReceivedDelegate}">
          <bpmn:documentation>Marks the current snapshot as received and prepares it for the buyer review step.</bpmn:documentation>
          <bpmn:incoming>Flow_13j2mea</bpmn:incoming>
          <bpmn:incoming>Flow_11399hj</bpmn:incoming>
          <bpmn:outgoing>Flow_09544si</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Flow_13j2mea" sourceRef="confirm-status-timeout" targetRef="product-received" />
        <bpmn:sequenceFlow id="Flow_11399hj" name="status is received" sourceRef="Gateway_17zsqkh" targetRef="product-received">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "RECEIVED"}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:userTask id="review-product" name="review product" camunda:assignee="user">
          <bpmn:documentation>the buyer leave a review to the product</bpmn:documentation>
          <bpmn:incoming>Flow_09544si</bpmn:incoming>
          <bpmn:outgoing>Flow_0aakhix</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="Flow_0aakhix" sourceRef="review-product" targetRef="mark-snapshot-reviewed-check-completiona" />
        <bpmn:sequenceFlow id="Flow_09544si" sourceRef="product-received" targetRef="review-product" />
        <bpmn:boundaryEvent id="review-time-out" name="review time out" attachedToRef="review-product">
          <bpmn:documentation>automatically set product's snapshot to completed when out of review deadline</bpmn:documentation>
          <bpmn:outgoing>Flow_1kgg2b3</bpmn:outgoing>
          <bpmn:timerEventDefinition id="TimerEventDefinition_18u5jl6">
            <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${reviewExpireAt}</bpmn:timeDate>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:sequenceFlow id="Flow_1kgg2b3" sourceRef="review-time-out" targetRef="mark-snapshot-reviewed-check-completiona" />
        <bpmn:startEvent id="Event_1u6wa1g" name="Start Snapshot Delivery">
          <bpmn:documentation>Starts the delivery and buyer-confirmation lifecycle for the current product snapshot.</bpmn:documentation>
          <bpmn:outgoing>Flow_1nwqf9i</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Flow_0gqon7d" sourceRef="Gateway_1y0n83r" targetRef="Event_0w8dhzr">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allSnapshotCompleted == false}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:endEvent id="Event_0w8dhzr" name="Wait for Remaining Snapshots">
          <bpmn:documentation>Ends this snapshot instance while other snapshots in the same sub-order are still active.</bpmn:documentation>
          <bpmn:incoming>Flow_0gqon7d</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:endEvent id="Event_0i8gqxm" name="Wait for Remaining Returns">
          <bpmn:documentation>Ends this returned-snapshot instance while other snapshots in the same sub-order are still active.</bpmn:documentation>
          <bpmn:incoming>Flow_09k03uu</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:boundaryEvent id="confirm-status-timeout" name="Buyer Confirmation Timeout" attachedToRef="confirm-delivery-status">
          <bpmn:documentation>Uses the default received outcome when the buyer does not confirm delivery before the deadline.</bpmn:documentation>
          <bpmn:outgoing>Flow_13j2mea</bpmn:outgoing>
          <bpmn:timerEventDefinition id="TimerEventDefinition_0g4r708">
            <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${confirmExpireAt}</bpmn:timeDate>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:sequenceFlow id="Flow_09k03uu" sourceRef="Gateway_0sb8w97" targetRef="Event_0i8gqxm">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allSnapshotCompleted == false}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_003bx1n" sourceRef="Gateway_0sb8w97" targetRef="Event_1hd9vqw">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allSnapshotCompleted == true}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_1le0n4j" sourceRef="mark-snapshot-returned-check-completiona" targetRef="Gateway_0sb8w97" />
        <bpmn:exclusiveGateway id="Gateway_0sb8w97" name="All Returns Finalized?">
          <bpmn:documentation>Checks whether every snapshot in the current sub-order has finished its return or completion path.</bpmn:documentation>
          <bpmn:incoming>Flow_1le0n4j</bpmn:incoming>
          <bpmn:outgoing>Flow_09k03uu</bpmn:outgoing>
          <bpmn:outgoing>Flow_003bx1n</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:callActivity id="Activity_1jn2yj1" name="Run Snapshot Delivery" calledElement="delivery-process">
          <bpmn:documentation>start delivery process</bpmn:documentation>
          <bpmn:extensionElements>
            <camunda:in variables="all" />
            <camunda:in sourceExpression="${false}" target="returnProcess" />
            <camunda:out variables="all" />
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_0v81tlt</bpmn:incoming>
          <bpmn:outgoing>Flow_0t18azj</bpmn:outgoing>
        </bpmn:callActivity>
        <bpmn:sequenceFlow id="Flow_1nwqf9i" sourceRef="Event_1u6wa1g" targetRef="Activity_1uedxw3" />
        <bpmn:sequenceFlow id="Flow_0t18azj" sourceRef="Activity_1jn2yj1" targetRef="Gateway_0j3d2wr" />
        <bpmn:serviceTask id="product-not-received" name="product not received" camunda:delegateExpression="${productNotReceivedDelegate}">
          <bpmn:documentation>Records an unsuccessful delivery attempt and prepares the snapshot for another shipper pickup when retries remain.</bpmn:documentation>
          <bpmn:incoming>Flow_0vk1njt</bpmn:incoming>
          <bpmn:outgoing>Flow_0bo86a1</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:userTask id="Activity_1uedxw3" name="Accept Snapshot for Delivery" camunda:candidateGroups="SHIPPER">
          <bpmn:documentation>A shipper accepts responsibility for delivering the current product snapshot.</bpmn:documentation>
          <bpmn:incoming>Flow_1nwqf9i</bpmn:incoming>
          <bpmn:incoming>Flow_0bo86a1</bpmn:incoming>
          <bpmn:outgoing>Flow_0v81tlt</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="Flow_0v81tlt" sourceRef="Activity_1uedxw3" targetRef="Activity_1jn2yj1" />
        <bpmn:exclusiveGateway id="Gateway_0j3d2wr" name="Evaluate Delivery Attempt">
          <bpmn:documentation>Routes a successful delivery to buyer confirmation or an unsuccessful attempt to the retry path.</bpmn:documentation>
          <bpmn:incoming>Flow_0t18azj</bpmn:incoming>
          <bpmn:outgoing>Flow_161aw17</bpmn:outgoing>
          <bpmn:outgoing>Flow_0vk1njt</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Flow_161aw17" sourceRef="Gateway_0j3d2wr" targetRef="confirm-delivery-status">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "RECEIVED"}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_0vk1njt" sourceRef="Gateway_0j3d2wr" targetRef="product-not-received">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "NOT_RECEIVED"  &amp;&amp; retry &lt; 3}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_0bo86a1" sourceRef="product-not-received" targetRef="Activity_1uedxw3" />
      </bpmn:subProcess>
      <bpmn:startEvent id="start-multi" name="start multi-instance buy process">
        <bpmn:documentation>Starts the workflow instance for the current sub-order.</bpmn:documentation>
        <bpmn:outgoing>Flow_1abco4h</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_1abco4h" sourceRef="start-multi" targetRef="confirmation-sub-process" />
      <bpmn:subProcess id="confirmation-sub-process" name="sub-order confirmation sub-process">
        <bpmn:documentation>Handles contributor approval, packing, agency handoff, and transaction-wide consolidation for the current sub-order.</bpmn:documentation>
        <bpmn:incoming>Flow_1abco4h</bpmn:incoming>
        <bpmn:outgoing>Flow_1dx9lqy</bpmn:outgoing>
        <bpmn:endEvent id="Event_1a4drjf" name="Order Rejected">
          <bpmn:documentation>Raises ORDER_REJECTED after the current sub-order has been rejected.</bpmn:documentation>
          <bpmn:incoming>Flow_0m36r9q</bpmn:incoming>
          <bpmn:errorEventDefinition id="ErrorEventDefinition_1ajw6mj" errorRef="Error_065513k" />
        </bpmn:endEvent>
        <bpmn:endEvent id="Event_0hrqcco" name="Failed to Deliver to Agency">
          <bpmn:documentation>Raises ORDER_CANCELED after the current sub-order has been cancelled because agency handoff failed or timed out.</bpmn:documentation>
          <bpmn:incoming>Flow_07esah3</bpmn:incoming>
          <bpmn:errorEventDefinition id="ErrorEventDefinition_1ojw4zx" errorRef="Error_164xo4i" />
        </bpmn:endEvent>
        <bpmn:exclusiveGateway id="Gateway_0xqos95" name="Delivered to Agency?">
          <bpmn:documentation>Checks the contributor's agency-handoff confirmation for the current sub-order.</bpmn:documentation>
          <bpmn:incoming>Flow_0sie111</bpmn:incoming>
          <bpmn:outgoing>Flow_0h11pw7</bpmn:outgoing>
          <bpmn:outgoing>Flow_1lsqm1m</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Flow_0h11pw7" sourceRef="Gateway_0xqos95" targetRef="cancel-sub-order">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliveredToAgency == false}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:startEvent id="Event_1x4u9vo" name="Start Sub-order Confirmation">
          <bpmn:documentation>Starts contributor confirmation for the current shop-level sub-order.</bpmn:documentation>
          <bpmn:outgoing>Flow_0s0zfwt</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Flow_1lsqm1m" sourceRef="Gateway_0xqos95" targetRef="Activity_18spb66">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliveredToAgency == true}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:serviceTask id="approve-order" name="approve order" camunda:delegateExpression="${transactionApprovedDelegate}">
          <bpmn:documentation>transaction status is packing</bpmn:documentation>
          <bpmn:incoming>Flow_0kd4mow</bpmn:incoming>
          <bpmn:outgoing>Flow_1j0o1cx</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Flow_1j0o1cx" sourceRef="approve-order" targetRef="confirm-delivery-to-transportation-agency" />
        <bpmn:userTask id="confirm-products-of-sub-order" name="confirm products of sub-order" camunda:assignee="contributor of the product">
          <bpmn:documentation>the contributor of the product confirm whether the transaction can be executed or not</bpmn:documentation>
          <bpmn:incoming>Flow_0s0zfwt</bpmn:incoming>
          <bpmn:outgoing>Flow_052t3lo</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="Flow_0s0zfwt" sourceRef="Event_1x4u9vo" targetRef="confirm-products-of-sub-order" />
        <bpmn:boundaryEvent id="confirmation-timeout" name="Contributor Confirmation Timeout" attachedToRef="confirm-products-of-sub-order">
          <bpmn:documentation>Rejects the current sub-order when its contributor does not respond before the confirmation deadline.</bpmn:documentation>
          <bpmn:outgoing>Flow_0x2zgxd</bpmn:outgoing>
          <bpmn:timerEventDefinition id="TimerEventDefinition_0jjh6jv">
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:sequenceFlow id="Flow_0x2zgxd" sourceRef="confirmation-timeout" targetRef="reject-cancel" />
        <bpmn:exclusiveGateway id="Gateway_034q4rj" name="Sub-order Approved?">
          <bpmn:documentation>Routes contributor approval to packing or rejection to the sub-order rejection task.</bpmn:documentation>
          <bpmn:incoming>Flow_052t3lo</bpmn:incoming>
          <bpmn:outgoing>Flow_0x50fh5</bpmn:outgoing>
          <bpmn:outgoing>Flow_0kd4mow</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Flow_0x50fh5" name="order rejected" sourceRef="Gateway_034q4rj" targetRef="reject-cancel">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approve == false}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_0kd4mow" name="order approved" sourceRef="Gateway_034q4rj" targetRef="approve-order">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approve == true}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_052t3lo" sourceRef="confirm-products-of-sub-order" targetRef="Gateway_034q4rj" />
        <bpmn:userTask id="confirm-delivery-to-transportation-agency" name="confirm the product was delivered to the transportation agency" camunda:assignee="contributor of the product">
          <bpmn:documentation>The contributor confirms whether the packed sub-order reached the transportation agency.</bpmn:documentation>
          <bpmn:incoming>Flow_1j0o1cx</bpmn:incoming>
          <bpmn:outgoing>Flow_0sie111</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="Flow_0sie111" sourceRef="confirm-delivery-to-transportation-agency" targetRef="Gateway_0xqos95" />
        <bpmn:boundaryEvent id="delivering-to-agency-timeout" name="Agency Handoff Timeout" attachedToRef="confirm-delivery-to-transportation-agency">
          <bpmn:documentation>Cancels the current sub-order when the contributor does not confirm agency handoff before the deadline.</bpmn:documentation>
          <bpmn:outgoing>Flow_1dkssxu</bpmn:outgoing>
          <bpmn:timerEventDefinition id="TimerEventDefinition_0wv98nl">
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:serviceTask id="Activity_18spb66" name="Record Agency Arrival and Check All Accepted" camunda:delegateExpression="${completeConfirmationSubProcessAndCheckCompletionDelegate}">
          <bpmn:documentation>Marks the current sub-order as accepted at the agency and checks whether every sibling sub-order has also arrived.</bpmn:documentation>
          <bpmn:incoming>Flow_1lsqm1m</bpmn:incoming>
          <bpmn:outgoing>Flow_1xwi6o1</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="Gateway_1qk3aq0" name="All Sub-orders Accepted?">
          <bpmn:documentation>Routes all accepted sub-orders to AWAITING_PICKUP; otherwise the current sub-order waits for consolidation.</bpmn:documentation>
          <bpmn:incoming>Flow_1xwi6o1</bpmn:incoming>
          <bpmn:outgoing>Flow_0fwe2u4</bpmn:outgoing>
          <bpmn:outgoing>Flow_1f9l52k</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="Event_0vyubwd" name="All Sub-orders Awaiting Pickup">
          <bpmn:documentation>mark all of the sub-order AWAITING_PICKUP</bpmn:documentation>
          <bpmn:incoming>Flow_0fwe2u4</bpmn:incoming>
          <bpmn:messageEventDefinition id="MessageEventDefinition_1huyh1m" camunda:delegateExpression="${markAllSubOrdersAwaitingPickupDelegate}" />
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_0fwe2u4" sourceRef="Gateway_1qk3aq0" targetRef="Event_0vyubwd">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allSubOrderConfirmed == true}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:endEvent id="Event_0bnzec2" name="Wait for Remaining Sub-orders">
          <bpmn:documentation>mark the sub-order WAITING_FOR_CONSOLIDATION</bpmn:documentation>
          <bpmn:incoming>Flow_1f9l52k</bpmn:incoming>
          <bpmn:messageEventDefinition id="MessageEventDefinition_waiting_for_consolidation" camunda:delegateExpression="${markSubOrderWaitingForConsolidationDelegate}" />
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_1f9l52k" sourceRef="Gateway_1qk3aq0" targetRef="Event_0bnzec2">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allSubOrderConfirmed == false}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_1xwi6o1" sourceRef="Activity_18spb66" targetRef="Gateway_1qk3aq0" />
        <bpmn:serviceTask id="reject-cancel" name="reject sub-order" camunda:delegateExpression="${subOrderRejectedDelegate}">
          <bpmn:documentation>Sets only the current sub-order and its snapshots to REJECTED, restores reserved stock, and then raises ORDER_REJECTED.</bpmn:documentation>
          <bpmn:incoming>Flow_0x50fh5</bpmn:incoming>
          <bpmn:incoming>Flow_0x2zgxd</bpmn:incoming>
          <bpmn:outgoing>Flow_0m36r9q</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Flow_0m36r9q" sourceRef="reject-cancel" targetRef="Event_1a4drjf" />
        <bpmn:serviceTask id="cancel-sub-order" name="cancel sub-order" camunda:delegateExpression="${subOrderCanceledDelegate}">
          <bpmn:documentation>Sets only the current sub-order and its active snapshots to CANCELLED, restores unfulfilled stock, and then raises ORDER_CANCELED.</bpmn:documentation>
          <bpmn:incoming>Flow_0h11pw7</bpmn:incoming>
          <bpmn:incoming>Flow_1dkssxu</bpmn:incoming>
          <bpmn:outgoing>Flow_07esah3</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Flow_07esah3" sourceRef="cancel-sub-order" targetRef="Event_0hrqcco" />
        <bpmn:sequenceFlow id="Flow_1dkssxu" sourceRef="delivering-to-agency-timeout" targetRef="cancel-sub-order" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="Flow_1dx9lqy" sourceRef="confirmation-sub-process" targetRef="Activity_1oo2pcq" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_0f375rx" sourceRef="multi-instance-sub-process" targetRef="Event_0psd029" />
    <bpmn:serviceTask id="transaction-cancel" name="Cancel Transaction" camunda:delegateExpression="${TransactionCanceledDelegate}">
      <bpmn:documentation>Sets the parent transaction to CANCELLED after a sub-order cancellation error or a user cancellation message interrupts the transaction workflow.</bpmn:documentation>
      <bpmn:incoming>Flow_0h6pax0</bpmn:incoming>
      <bpmn:incoming>Flow_03lh8u6</bpmn:incoming>
      <bpmn:outgoing>Flow_1stjrkb</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_0u0o0cw" name="Transaction Cancelled">
      <bpmn:documentation>Ends the buying process after the parent transaction has been persisted as CANCELLED.</bpmn:documentation>
      <bpmn:incoming>Flow_1stjrkb</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="reject-order" name="Reject Transaction" camunda:delegateExpression="${transactionRejectedDelegate}">
      <bpmn:documentation>Sets the parent transaction to REJECTED after the current sub-order rejection raises ORDER_REJECTED.</bpmn:documentation>
      <bpmn:incoming>Flow_1jkgiiv</bpmn:incoming>
      <bpmn:outgoing>Flow_1d2jkz8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_1t3toat" name="Transaction Rejected">
      <bpmn:documentation>Ends the buying process after the parent transaction has been persisted as REJECTED.</bpmn:documentation>
      <bpmn:incoming>Flow_1d2jkz8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Event_0sdj8yi" name="Sub-order Rejected" attachedToRef="multi-instance-sub-process">
      <bpmn:documentation>Catches ORDER_REJECTED from a sub-order instance, interrupts the remaining instances, and routes to parent transaction rejection.</bpmn:documentation>
      <bpmn:outgoing>Flow_1jkgiiv</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1s7xl7u" errorRef="Error_065513k" camunda:errorCodeVariable="rejectErrorCode" camunda:errorMessageVariable="rejectErrorMessage" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_0d416tw" name="contributor cancel or timeout" attachedToRef="multi-instance-sub-process">
      <bpmn:documentation>Catches ORDER_CANCELED from a sub-order instance, interrupts the remaining instances, and routes to parent transaction cancellation.</bpmn:documentation>
      <bpmn:outgoing>Flow_0h6pax0</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_0vr1v48" errorRef="Error_164xo4i" camunda:errorCodeVariable="cancelErrorCode" camunda:errorMessageVariable="cancelErrorMessage" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_1hkshcn" name="user cancel" attachedToRef="multi-instance-sub-process">
      <bpmn:documentation>Interrupts all active sub-order instances when a user cancellation message is received and routes to parent transaction cancellation.</bpmn:documentation>
      <bpmn:outgoing>Flow_03lh8u6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0e0wxhf" messageRef="Message_0k71eps" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_0h6pax0" sourceRef="Event_0d416tw" targetRef="transaction-cancel" />
    <bpmn:sequenceFlow id="Flow_03lh8u6" sourceRef="Event_1hkshcn" targetRef="transaction-cancel" />
    <bpmn:sequenceFlow id="Flow_1stjrkb" sourceRef="transaction-cancel" targetRef="Event_0u0o0cw" />
    <bpmn:sequenceFlow id="Flow_1jkgiiv" sourceRef="Event_0sdj8yi" targetRef="reject-order" />
    <bpmn:sequenceFlow id="Flow_1d2jkz8" sourceRef="reject-order" targetRef="Event_1t3toat" />
  </bpmn:process>
