<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_11zc6qf" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="buying-items-procedure" name="buying items procedure" isExecutable="true">
    <bpmn:documentation>transaction status is delivering</bpmn:documentation>
    <bpmn:extensionElements>
      <camunda:executionListener delegateExpression="${syncDbStatusDelegate}" event="start" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="start-buy-products" name="buy products">
      <bpmn:documentation>can buy one or multiple products ,transaction status is pending</bpmn:documentation>
      <bpmn:outgoing>Flow_1r5wkgl</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="create-transaction-and-sub-order" name="create transaction and sub-order" camunda:delegateExpression="${createTransactionAndSubOrderDelegate}">
      <bpmn:documentation>transaction contain sub-orders (each sub-order is for a different shop) , a sub-order contain product snapshots which represent the delivery status of a product</bpmn:documentation>
      <bpmn:incoming>Flow_1r5wkgl</bpmn:incoming>
      <bpmn:outgoing>Flow_1s47z05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1r5wkgl" sourceRef="start-buy-products" targetRef="create-transaction-and-sub-order" />
    <bpmn:sequenceFlow id="Flow_1s47z05" sourceRef="create-transaction-and-sub-order" targetRef="multi-instance-sub-process" />
    <bpmn:endEvent id="Event_0psd029" name="transaction complete">
      <bpmn:incoming>Flow_0f375rx</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_01sfitk" camunda:delegateExpression="${completeTransactionDelegate}" />
    </bpmn:endEvent>
    <bpmn:subProcess id="multi-instance-sub-process" name="multi-instance sub-process for sub-orders">
      <bpmn:incoming>Flow_1s47z05</bpmn:incoming>
      <bpmn:outgoing>Flow_0f375rx</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics camunda:collection="subOrderIds" camunda:elementVariable="subOrderId" />
      <bpmn:subProcess id="Activity_1oo2pcq">
        <bpmn:incoming>Flow_1dx9lqy</bpmn:incoming>
        <bpmn:multiInstanceLoopCharacteristics camunda:collection="${execution.getVariable(&#39;snapshotIds_&#39;.concat(subOrderId))}" camunda:elementVariable="snapshotId" />
        <bpmn:serviceTask id="mark-snapshot-returned-check-completiona" name="Mark Snapshot returned &#38; Check Completion" camunda:delegateExpression="${markSnapshotReturnAndCheckCompletionDelegate}">
          <bpmn:incoming>Flow_0qynngk</bpmn:incoming>
          <bpmn:outgoing>Flow_1le0n4j</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="Event_1hd9vqw" name="sub-order completed">
          <bpmn:incoming>Flow_003bx1n</bpmn:incoming>
          <bpmn:messageEventDefinition id="MessageEventDefinition_0lnq0c2" camunda:delegateExpression="${startReturnProcessDelegate}" />
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_1le0n4j" sourceRef="mark-snapshot-returned-check-completiona" targetRef="Gateway_0sb8w97" />
        <bpmn:serviceTask id="mark-snapshot-reviewed-check-completiona" name="Mark Snapshot Reviewed &#38; Check Completion" camunda:delegateExpression="${markSnapshotReviewAndCheckCompletionDelegate}">
          <bpmn:documentation>set is review to true and complete sub-order if all of snapshot is review is true</bpmn:documentation>
          <bpmn:incoming>Flow_0aakhix</bpmn:incoming>
          <bpmn:incoming>Flow_1kgg2b3</bpmn:incoming>
          <bpmn:outgoing>Flow_0x7oukv</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="Gateway_1y0n83r" camunda:asyncBefore="true">
          <bpmn:incoming>Flow_0x7oukv</bpmn:incoming>
          <bpmn:outgoing>Flow_1sbtnyr</bpmn:outgoing>
          <bpmn:outgoing>Flow_0gqon7d</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Flow_0x7oukv" sourceRef="mark-snapshot-reviewed-check-completiona" targetRef="Gateway_1y0n83r" />
        <bpmn:endEvent id="sub-order-completed" name="sub-order completed">
          <bpmn:incoming>Flow_1sbtnyr</bpmn:incoming>
          <bpmn:messageEventDefinition id="MessageEventDefinition_1lth0uo" camunda:delegateExpression="${completeSubOrderDelegate}" />
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_1sbtnyr" sourceRef="Gateway_1y0n83r" targetRef="sub-order-completed">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allSnapshotCompleted == true}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:userTask id="confirm-delivery-status" name="Confirm Delivery Status" camunda:assignee="the buyer of the product">
          <bpmn:documentation>customer confirm if the had received the product or not,
if they are not sastified with the product they can return it at this step</bpmn:documentation>
          <bpmn:incoming>Flow_13b3cw3</bpmn:incoming>
          <bpmn:outgoing>Flow_1l0tmco</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="Flow_1l0tmco" sourceRef="confirm-delivery-status" targetRef="Gateway_17zsqkh" />
        <bpmn:exclusiveGateway id="Gateway_17zsqkh">
          <bpmn:incoming>Flow_1l0tmco</bpmn:incoming>
          <bpmn:outgoing>Flow_0qynngk</bpmn:outgoing>
          <bpmn:outgoing>Flow_0mo9xxv</bpmn:outgoing>
          <bpmn:outgoing>Flow_11399hj</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Flow_0qynngk" name="status is returned or retry &#62;= 3" sourceRef="Gateway_17zsqkh" targetRef="mark-snapshot-returned-check-completiona">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "RETURNED" || retry &gt;= 3}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:serviceTask id="product-not-received" name="product not received" camunda:delegateExpression="${productNotReceivedDelegate}">
          <bpmn:incoming>Flow_0mo9xxv</bpmn:incoming>
          <bpmn:outgoing>Flow_0xo44pl</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Flow_0mo9xxv" name="status is not received and retry &#60; 3" sourceRef="Gateway_17zsqkh" targetRef="product-not-received">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "NOT_RECEIVED"  &amp;&amp; retry &lt; 3}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:serviceTask id="product-received" name="product received" camunda:delegateExpression="${productReceivedDelegate}">
          <bpmn:incoming>Flow_13j2mea</bpmn:incoming>
          <bpmn:incoming>Flow_11399hj</bpmn:incoming>
          <bpmn:outgoing>Flow_09544si</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Flow_13j2mea" sourceRef="confirm-status-timeout" targetRef="product-received" />
        <bpmn:sequenceFlow id="Flow_11399hj" name="status is received" sourceRef="Gateway_17zsqkh" targetRef="product-received">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "RECEIVED"}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:userTask id="review-product" name="review product" camunda:assignee="user">
          <bpmn:documentation>the buyer leave a review to the product</bpmn:documentation>
          <bpmn:incoming>Flow_09544si</bpmn:incoming>
          <bpmn:outgoing>Flow_0aakhix</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="Flow_0aakhix" sourceRef="review-product" targetRef="mark-snapshot-reviewed-check-completiona" />
        <bpmn:sequenceFlow id="Flow_09544si" sourceRef="product-received" targetRef="review-product" />
        <bpmn:boundaryEvent id="review-time-out" name="review time out" attachedToRef="review-product">
          <bpmn:documentation>automatically set product's snapshot to completed when out of review deadline</bpmn:documentation>
          <bpmn:outgoing>Flow_1kgg2b3</bpmn:outgoing>
          <bpmn:timerEventDefinition id="TimerEventDefinition_18u5jl6">
            <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${reviewExpireAt}</bpmn:timeDate>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:sequenceFlow id="Flow_1kgg2b3" sourceRef="review-time-out" targetRef="mark-snapshot-reviewed-check-completiona" />
        <bpmn:intermediateCatchEvent id="mock-delivery-process" name="mock delivery process">
          <bpmn:documentation>mock delivery time by setting</bpmn:documentation>
          <bpmn:incoming>Flow_0xo44pl</bpmn:incoming>
          <bpmn:incoming>Flow_1p5wdu3</bpmn:incoming>
          <bpmn:outgoing>Flow_0qro8j6</bpmn:outgoing>
          <bpmn:timerEventDefinition id="TimerEventDefinition_10wikaw">
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15S</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:serviceTask id="deliver-the-product" name="deliver the product" camunda:delegateExpression="${deliverTheProductDelegate}">
          <bpmn:documentation>product status is under user confirmation</bpmn:documentation>
          <bpmn:incoming>Flow_0qro8j6</bpmn:incoming>
          <bpmn:outgoing>Flow_13b3cw3</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Flow_0qro8j6" sourceRef="mock-delivery-process" targetRef="deliver-the-product" />
        <bpmn:sequenceFlow id="Flow_13b3cw3" sourceRef="deliver-the-product" targetRef="confirm-delivery-status" />
        <bpmn:startEvent id="Event_1u6wa1g" name="start user delivery confirmation">
          <bpmn:outgoing>Flow_1p5wdu3</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Flow_0xo44pl" sourceRef="product-not-received" targetRef="mock-delivery-process" />
        <bpmn:sequenceFlow id="Flow_1p5wdu3" sourceRef="Event_1u6wa1g" targetRef="mock-delivery-process" />
        <bpmn:sequenceFlow id="Flow_0gqon7d" sourceRef="Gateway_1y0n83r" targetRef="Event_0w8dhzr">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allSnapshotCompleted == false}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:endEvent id="Event_0w8dhzr" name="sub-order  not completed">
          <bpmn:incoming>Flow_0gqon7d</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:exclusiveGateway id="Gateway_0sb8w97">
          <bpmn:incoming>Flow_1le0n4j</bpmn:incoming>
          <bpmn:outgoing>Flow_003bx1n</bpmn:outgoing>
          <bpmn:outgoing>Flow_09k03uu</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Flow_003bx1n" sourceRef="Gateway_0sb8w97" targetRef="Event_1hd9vqw">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allSnapshotCompleted == true}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_09k03uu" sourceRef="Gateway_0sb8w97" targetRef="Event_0i8gqxm">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allSnapshotCompleted == false}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:endEvent id="Event_0i8gqxm" name="sub-order not completed">
          <bpmn:incoming>Flow_09k03uu</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:boundaryEvent id="confirm-status-timeout" name="confirm status timeout" attachedToRef="confirm-delivery-status">
          <bpmn:outgoing>Flow_13j2mea</bpmn:outgoing>
          <bpmn:timerEventDefinition id="TimerEventDefinition_0g4r708">
            <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${confirmExpireAt}</bpmn:timeDate>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
      </bpmn:subProcess>
      <bpmn:endEvent id="Event_1t3toat" name="Order Rejected">
        <bpmn:incoming>Flow_13aebtz</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="reject-order" name="reject order" camunda:delegateExpression="${transactionRejectedDelegate}">
        <bpmn:documentation>transaction's status is rejected</bpmn:documentation>
        <bpmn:incoming>Flow_0lql8n4</bpmn:incoming>
        <bpmn:outgoing>Flow_13aebtz</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_13aebtz" sourceRef="reject-order" targetRef="Event_1t3toat" />
      <bpmn:endEvent id="Event_0u0o0cw" name="order canceled">
        <bpmn:incoming>Flow_0n8cs1l</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="order-cancel" name="cancel order" camunda:delegateExpression="${cancelOrderDelegate}">
        <bpmn:incoming>Flow_15h1tqw</bpmn:incoming>
        <bpmn:incoming>Flow_0xfy0kq</bpmn:incoming>
        <bpmn:outgoing>Flow_0n8cs1l</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_0n8cs1l" sourceRef="order-cancel" targetRef="Event_0u0o0cw" />
      <bpmn:startEvent id="start-multi" name="start multi-instance buy process">
        <bpmn:outgoing>Flow_1abco4h</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_1abco4h" sourceRef="start-multi" targetRef="confirmation-sub-process" />
      <bpmn:subProcess id="confirmation-sub-process" name="sub-order confirmation sub-process">
        <bpmn:incoming>Flow_1abco4h</bpmn:incoming>
        <bpmn:outgoing>Flow_1dx9lqy</bpmn:outgoing>
        <bpmn:endEvent id="Event_1a4drjf" name="Order Rejected">
          <bpmn:incoming>Flow_0x2zgxd</bpmn:incoming>
          <bpmn:incoming>Flow_0x50fh5</bpmn:incoming>
          <bpmn:errorEventDefinition id="ErrorEventDefinition_1ajw6mj" errorRef="Error_065513k" />
        </bpmn:endEvent>
        <bpmn:endEvent id="Event_0hrqcco" name="Failed to Deliver to Agency">
          <bpmn:incoming>Flow_0h11pw7</bpmn:incoming>
          <bpmn:errorEventDefinition id="ErrorEventDefinition_1ojw4zx" errorRef="Error_164xo4i" />
        </bpmn:endEvent>
        <bpmn:exclusiveGateway id="Gateway_0xqos95">
          <bpmn:incoming>Flow_0sie111</bpmn:incoming>
          <bpmn:outgoing>Flow_0h11pw7</bpmn:outgoing>
          <bpmn:outgoing>Flow_1lsqm1m</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Flow_0h11pw7" sourceRef="Gateway_0xqos95" targetRef="Event_0hrqcco">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliveredToAgency == false}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:endEvent id="Event_08gbexc" name="Delivery to Agency Timeout">
          <bpmn:incoming>Flow_05pel4k</bpmn:incoming>
          <bpmn:errorEventDefinition id="ErrorEventDefinition_1di47hy" errorRef="Error_164xo4i" />
        </bpmn:endEvent>
        <bpmn:startEvent id="Event_1x4u9vo" name="start confirmation sub-process">
          <bpmn:outgoing>Flow_0s0zfwt</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:endEvent id="Event_0if24np" name="confirmation sub-process ended">
          <bpmn:incoming>Flow_1lsqm1m</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_1lsqm1m" sourceRef="Gateway_0xqos95" targetRef="Event_0if24np">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliveredToAgency == true}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:serviceTask id="approve-order" name="approve order" camunda:delegateExpression="${transactionApprovedDelegate}">
          <bpmn:documentation>transaction status is packing</bpmn:documentation>
          <bpmn:incoming>Flow_0kd4mow</bpmn:incoming>
          <bpmn:outgoing>Flow_1j0o1cx</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Flow_1j0o1cx" sourceRef="approve-order" targetRef="confirm-delivery-to-transportation-agency" />
        <bpmn:userTask id="confirm-products-of-sub-order" name="confirm products of sub-order" camunda:assignee="contributor of the product">
          <bpmn:documentation>the contributor of the product confirm whether the transaction can be executed or not</bpmn:documentation>
          <bpmn:incoming>Flow_0s0zfwt</bpmn:incoming>
          <bpmn:outgoing>Flow_052t3lo</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="Flow_0s0zfwt" sourceRef="Event_1x4u9vo" targetRef="confirm-products-of-sub-order" />
        <bpmn:boundaryEvent id="confirmation-timeout" name="confirmation timeout" attachedToRef="confirm-products-of-sub-order">
          <bpmn:outgoing>Flow_0x2zgxd</bpmn:outgoing>
          <bpmn:timerEventDefinition id="TimerEventDefinition_0jjh6jv">
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1M</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:sequenceFlow id="Flow_0x2zgxd" sourceRef="confirmation-timeout" targetRef="Event_1a4drjf" />
        <bpmn:exclusiveGateway id="Gateway_034q4rj">
          <bpmn:incoming>Flow_052t3lo</bpmn:incoming>
          <bpmn:outgoing>Flow_0x50fh5</bpmn:outgoing>
          <bpmn:outgoing>Flow_0kd4mow</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Flow_0x50fh5" name="order rejected" sourceRef="Gateway_034q4rj" targetRef="Event_1a4drjf">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approve == false}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_0kd4mow" name="order approved" sourceRef="Gateway_034q4rj" targetRef="approve-order">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approve == true}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_052t3lo" sourceRef="confirm-products-of-sub-order" targetRef="Gateway_034q4rj" />
        <bpmn:userTask id="confirm-delivery-to-transportation-agency" name="confirm the product was delivered to the transportation agency" camunda:assignee="contributor of the product">
          <bpmn:incoming>Flow_1j0o1cx</bpmn:incoming>
          <bpmn:outgoing>Flow_0sie111</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="Flow_0sie111" sourceRef="confirm-delivery-to-transportation-agency" targetRef="Gateway_0xqos95" />
        <bpmn:boundaryEvent id="delivering-to-agency-timeout" name="delivering to agency timeout" attachedToRef="confirm-delivery-to-transportation-agency">
          <bpmn:outgoing>Flow_05pel4k</bpmn:outgoing>
          <bpmn:timerEventDefinition id="TimerEventDefinition_0wv98nl">
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1M</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:sequenceFlow id="Flow_05pel4k" sourceRef="delivering-to-agency-timeout" targetRef="Event_08gbexc" />
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="Event_1hkshcn" name="user cancel" attachedToRef="confirmation-sub-process">
        <bpmn:outgoing>Flow_15h1tqw</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_0e0wxhf" messageRef="Message_0k71eps" />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_15h1tqw" sourceRef="Event_1hkshcn" targetRef="order-cancel" />
      <bpmn:boundaryEvent id="Event_0d416tw" name="contributor cancel or timeout" attachedToRef="confirmation-sub-process">
        <bpmn:outgoing>Flow_0xfy0kq</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_0vr1v48" errorRef="Error_164xo4i" camunda:errorCodeVariable="cancelErrorCode" camunda:errorMessageVariable="cancelErrorMessage" />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_0xfy0kq" sourceRef="Event_0d416tw" targetRef="order-cancel" />
      <bpmn:boundaryEvent id="Event_0sdj8yi" attachedToRef="confirmation-sub-process">
        <bpmn:outgoing>Flow_0lql8n4</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_1s7xl7u" errorRef="Error_065513k" camunda:errorCodeVariable="rejectErrorCode" camunda:errorMessageVariable="rejectErrorMessage" />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_0lql8n4" sourceRef="Event_0sdj8yi" targetRef="reject-order" />
      <bpmn:sequenceFlow id="Flow_1dx9lqy" sourceRef="confirmation-sub-process" targetRef="Activity_1oo2pcq" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_0f375rx" sourceRef="multi-instance-sub-process" targetRef="Event_0psd029" />
  </bpmn:process>
  <bpmn:error id="Error_0y38urr" />
  <bpmn:error id="Error_11mv1so" name="Error_11i5o7h" />
  <bpmn:error id="Error_101nwv1" name="Error_28k611m" />
  <bpmn:error id="Error_164xo4i" name="cancel order" errorCode="ORDER_CANCELED" camunda:errorMessage="there is some problem with your order read the description for detail" />
  <bpmn:message id="Message_0k71eps" name="user-cancel-msg" />
  <bpmn:error id="Error_065513k" name="reject order" errorCode="ORDER_REJECTED" camunda:errorMessage="your order was rejected or not responsed by the contributor" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="buying-items-procedure">
      <bpmndi:BPMNShape id="BPMNShape_0xf15gr" bpmnElement="start-buy-products">
        <dc:Bounds x="172" y="542" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="160" y="585" width="63" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_083dxkz" bpmnElement="create-transaction-and-sub-order">
        <dc:Bounds x="270" y="520" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_1pnamen_di" bpmnElement="Event_0psd029">
        <dc:Bounds x="3452" y="542" width="36" height="36" />
        <bpmndi:BPMNLabel>
