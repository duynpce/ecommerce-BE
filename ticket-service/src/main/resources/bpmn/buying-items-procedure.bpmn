<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_11zc6qf" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.21.0">
  <bpmn:process id="Process_0fsfzgs" name="buying items procedure" isExecutable="true">
    <bpmn:documentation>transaction status is delivering</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_1" name="buy a product">
      <bpmn:documentation>transaction status is pending</bpmn:documentation>
      <bpmn:outgoing>Flow_0rg42yu</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="confirm-the-transaction" name="confirm the transaction" camunda:assignee="contributor of the product">
      <bpmn:documentation>the contributor of the product confirm whether the transaction can be executed or not</bpmn:documentation>
      <bpmn:incoming>Flow_0rg42yu</bpmn:incoming>
      <bpmn:outgoing>Flow_0gqte6r</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0rg42yu" sourceRef="StartEvent_1" targetRef="confirm-the-transaction" />
    <bpmn:exclusiveGateway id="Gateway_13ykcro">
      <bpmn:incoming>Flow_0gqte6r</bpmn:incoming>
      <bpmn:outgoing>Flow_0r59t24</bpmn:outgoing>
      <bpmn:outgoing>Flow_1us7y2w</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0gqte6r" sourceRef="confirm-the-transaction" targetRef="Gateway_13ykcro" />
    <bpmn:serviceTask id="Activity_1i64x9m" name="transaction confirmed" camunda:delegateExpression="${transactionConfirmedDelegate}">
      <bpmn:documentation>transaction status is packing</bpmn:documentation>
      <bpmn:incoming>Flow_0r59t24</bpmn:incoming>
      <bpmn:outgoing>Flow_0gpfkai</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0r59t24" name="transaction approved" sourceRef="Gateway_13ykcro" targetRef="Activity_1i64x9m">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approve == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="transaction-rejected" name="transaction rejected" camunda:delegateExpression="${transactionRejectedDelegate}">
      <bpmn:documentation>transaction's status is rejected</bpmn:documentation>
      <bpmn:incoming>Flow_1us7y2w</bpmn:incoming>
      <bpmn:outgoing>Flow_0yuzwxi</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1us7y2w" name="transaction rejected" sourceRef="Gateway_13ykcro" targetRef="transaction-rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approve == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0b58587" name="transaction is set to rejected">
      <bpmn:incoming>Flow_0yuzwxi</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0yuzwxi" sourceRef="transaction-rejected" targetRef="Event_0b58587" />
    <bpmn:userTask id="delivered-to-transportation-confirmation" name="confirm the product was delivered to the transportation agency" camunda:assignee="contributor of the product">
      <bpmn:incoming>Flow_0gpfkai</bpmn:incoming>
      <bpmn:outgoing>Flow_0s3pys2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0gpfkai" sourceRef="Activity_1i64x9m" targetRef="delivered-to-transportation-confirmation" />
    <bpmn:intermediateCatchEvent id="mock-delivery-process" name="mock delivery process">
      <bpmn:documentation>mock delivery time by setting</bpmn:documentation>
      <bpmn:incoming>Flow_0s3pys2</bpmn:incoming>
      <bpmn:incoming>Flow_0dv5dix</bpmn:incoming>
      <bpmn:outgoing>Flow_0qro8j6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1aulqng">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_0s3pys2" sourceRef="delivered-to-transportation-confirmation" targetRef="mock-delivery-process" />
    <bpmn:serviceTask id="deliver-the-product" name="deliver the product." camunda:delegateExpression="${deliverTheProductDelegate}">
      <bpmn:documentation>product status is under user confirmation</bpmn:documentation>
      <bpmn:incoming>Flow_0qro8j6</bpmn:incoming>
      <bpmn:outgoing>Flow_1jdp7g0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0qro8j6" sourceRef="mock-delivery-process" targetRef="deliver-the-product" />
    <bpmn:userTask id="confirm-delivery-status" name="Confirm Delivery Status" camunda:assignee="the buyer of the product">
      <bpmn:documentation>customer confirm if the had received the product or not, 
if they are not sastified with the product they can return it at this step</bpmn:documentation>
      <bpmn:incoming>Flow_1jdp7g0</bpmn:incoming>
      <bpmn:outgoing>Flow_1l0tmco</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1jdp7g0" sourceRef="deliver-the-product" targetRef="confirm-delivery-status" />
    <bpmn:exclusiveGateway id="Gateway_17zsqkh">
      <bpmn:incoming>Flow_1l0tmco</bpmn:incoming>
      <bpmn:outgoing>Flow_0mo9xxv</bpmn:outgoing>
      <bpmn:outgoing>Flow_11399hj</bpmn:outgoing>
      <bpmn:outgoing>Flow_0qynngk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1l0tmco" sourceRef="confirm-delivery-status" targetRef="Gateway_17zsqkh" />
    <bpmn:serviceTask id="product-not-received" name="product not received" camunda:delegateExpression="${productNotReceivedDelegate}">
      <bpmn:incoming>Flow_0mo9xxv</bpmn:incoming>
      <bpmn:outgoing>Flow_0dv5dix</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0mo9xxv" name="status is not received and retry &#60; 3" sourceRef="Gateway_17zsqkh" targetRef="product-not-received">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "NOT_RECEIVED"  &amp;&amp; retry &lt; 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="product-received" name="product received" camunda:delegateExpression="${productReceivedDelegate}">
      <bpmn:incoming>Flow_11399hj</bpmn:incoming>
      <bpmn:outgoing>Flow_1i558j6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_11399hj" name="status is received" sourceRef="Gateway_17zsqkh" targetRef="product-received">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "RECEIVED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0qynngk" name="status is returned or retry &#62;= 3" sourceRef="Gateway_17zsqkh" targetRef="product-returned">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status = "RETURNED" || retry &gt;= 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0psd029" name="transaction complete">
      <bpmn:incoming>Flow_1i558j6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1i558j6" sourceRef="product-received" targetRef="Event_0psd029" />
    <bpmn:sequenceFlow id="Flow_0dv5dix" sourceRef="product-not-received" targetRef="mock-delivery-process" />
    <bpmn:endEvent id="Event_1hd9vqw" name="activate returning items procedure">
      <bpmn:incoming>Flow_1jth92o</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1jth92o" sourceRef="product-returned" targetRef="Event_1hd9vqw" />
    <bpmn:callActivity id="product-returned" name="product returned" calledElement="returning-products">
      <bpmn:documentation>activate returning process for contributor to received their returned products</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0qynngk</bpmn:incoming>
      <bpmn:outgoing>Flow_1jth92o</bpmn:outgoing>
    </bpmn:callActivity>
  </bpmn:process>
