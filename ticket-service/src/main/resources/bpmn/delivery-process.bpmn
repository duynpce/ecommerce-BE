        <dc:Bounds x="270" y="150" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_0xp8uyq_di" bpmnElement="Gateway_0xp8uyq" isMarkerVisible="true">
        <dc:Bounds x="425" y="165" width="50" height="50" />
      </bpmndi:BPMNShape>
