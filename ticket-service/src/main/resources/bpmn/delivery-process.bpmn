        <dc:Bounds x="692" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="674" y="145" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1r5rn3a_di" bpmnElement="Gateway_1r5rn3a" isMarkerVisible="true">
        <dc:Bounds x="685" y="245" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0dqq52r_di" bpmnElement="Event_0dqq52r">
        <dc:Bounds x="762" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_0ra00dd_di" bpmnElement="Gateway_0ra00dd" isMarkerVisible="true">
        <dc:Bounds x="765" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0e7ftte_di" bpmnElement="Event_0e7ftte">
        <dc:Bounds x="862" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0lbrs5g_di" bpmnElement="Event_0lbrs5g">
        <dc:Bounds x="862" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01kbguj_di" bpmnElement="Flow_01kbguj">
        <di:waypoint x="218" y="190" />
        <di:waypoint x="270" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1dpiwrc_di" bpmnElement="Flow_1dpiwrc">
        <di:waypoint x="370" y="190" />
        <di:waypoint x="425" y="190" />
      </bpmndi:BPMNEdge>
