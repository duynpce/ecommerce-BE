<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0mdenn9" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="delivery-process" name="delivery process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="item received">
      <bpmn:outgoing>Flow_01kbguj</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_1nc4s4r" name="Deliver Item and Report Outcome" camunda:assignee="${shipperId}">
      <bpmn:documentation>The shipper who accepted pickup records whether the customer received this product snapshot. RECEIVED completes delivery; NOT_RECEIVED follows the retry or return path.</bpmn:documentation>
      <bpmn:incoming>Flow_01kbguj</bpmn:incoming>
      <bpmn:outgoing>Flow_1dpiwrc</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_01kbguj" sourceRef="StartEvent_1" targetRef="Activity_1nc4s4r" />
    <bpmn:exclusiveGateway id="Gateway_0xp8uyq">
      <bpmn:incoming>Flow_1dpiwrc</bpmn:incoming>
      <bpmn:outgoing>Flow_137mej0</bpmn:outgoing>
      <bpmn:outgoing>Flow_10swbxs</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1dpiwrc" sourceRef="Activity_1nc4s4r" targetRef="Gateway_0xp8uyq" />
    <bpmn:serviceTask id="Activity_1tpx6y8" name="item received" camunda:delegateExpression="${deliverTheProductDelegate}">
      <bpmn:incoming>Flow_137mej0</bpmn:incoming>
      <bpmn:outgoing>Flow_1scizho</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_137mej0" name="staus is received" sourceRef="Gateway_0xp8uyq" targetRef="Activity_1tpx6y8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "RECEIVED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_1kk6lro" name="item not received" camunda:delegateExpression="${productNotReceivedDelegate}">
      <bpmn:incoming>Flow_10swbxs</bpmn:incoming>
      <bpmn:outgoing>Flow_06rizry</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_10swbxs" name="status is not received" sourceRef="Gateway_0xp8uyq" targetRef="Activity_1kk6lro">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "NOT_RECEIVED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_1kwd9on" name="delivery ended">
      <bpmn:incoming>Flow_1scizho</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1scizho" sourceRef="Activity_1tpx6y8" targetRef="Event_1kwd9on" />
    <bpmn:exclusiveGateway id="Gateway_1r5rn3a">
      <bpmn:incoming>Flow_06rizry</bpmn:incoming>
      <bpmn:outgoing>Flow_12ano3j</bpmn:outgoing>
      <bpmn:outgoing>Flow_16y7wkh</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_06rizry" sourceRef="Activity_1kk6lro" targetRef="Gateway_1r5rn3a" />
    <bpmn:endEvent id="Event_0dqq52r">
      <bpmn:incoming>Flow_12ano3j</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_00zhq0o" camunda:delegateExpression="${deliveryRetryDelegate}" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_12ano3j" sourceRef="Gateway_1r5rn3a" targetRef="Event_0dqq52r">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "NOT_RECEIVED" &amp;&amp; retry &lt; 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_0ra00dd">
      <bpmn:incoming>Flow_16y7wkh</bpmn:incoming>
      <bpmn:outgoing>Flow_1is12rz</bpmn:outgoing>
      <bpmn:outgoing>Flow_1jewb3z</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_16y7wkh" sourceRef="Gateway_1r5rn3a" targetRef="Gateway_0ra00dd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "NOT_RECEIVED" &amp;&amp; retry &gt;= 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0e7ftte">
      <bpmn:documentation>if the delivery is a return process then make it delivery failed</bpmn:documentation>
      <bpmn:incoming>Flow_1is12rz</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_delivery_failed" camunda:delegateExpression="${deliveryFailedDelegate}" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1is12rz" sourceRef="Gateway_0ra00dd" targetRef="Event_0e7ftte">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${returnProcess == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0lbrs5g">
      <bpmn:documentation>if the delivery is not a return process then create a new return process</bpmn:documentation>
      <bpmn:incoming>Flow_1jewb3z</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0hpgqlj" camunda:delegateExpression="${startReturnProcessDelegate}" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1jewb3z" sourceRef="Gateway_0ra00dd" targetRef="Event_0lbrs5g">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${returnProcess == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="delivery-process">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="182" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
